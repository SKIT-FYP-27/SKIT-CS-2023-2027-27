# Copy this file to .env and fill in your own local/remote PostgreSQL credentials.
# NEVER commit the real .env file to GitHub — it is already in .gitignore.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME"

# Example for a local Postgres instance running schema_v2.sql:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uei_db"
